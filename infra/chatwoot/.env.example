# Copy thành .env bằng: ./init-env.sh (tự sinh secret), hoặc copy tay rồi điền.
# Danh sách đầy đủ biến: https://github.com/chatwoot/chatwoot/blob/develop/.env.example

# --- Docker Compose ---
CHATWOOT_VERSION=v4.18.0
CHATWOOT_HOST_PORT=3100
POSTGRES_HOST_PORT=5433

# --- Chatwoot ---
SECRET_KEY_BASE=
FRONTEND_URL=http://localhost:3100
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=vi
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local

# --- Postgres (dùng chung cho container postgres và Chatwoot) ---
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# --- Email (để trống khi dev; cần cho mời nhân viên/quên mật khẩu ở production) ---
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# --- Facebook / Instagram (làm sau; bản mới có thể cấu hình trong /super_admin) ---
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=

# --- Webhook tới các service bridge (zalo-personal, zalo-oa) ---
# Chatwoot mặc định chặn webhook tới IP nội bộ (chống SSRF). Các service bridge chạy cùng máy/mạng Docker
# nên phải bật. Chỉ admin mới đặt được webhook URL nên chấp nhận được.
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true
