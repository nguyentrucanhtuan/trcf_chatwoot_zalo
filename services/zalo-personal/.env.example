# HTTP server của bridge
HOST=127.0.0.1
PORT=3200
# URL mà Chatwoot (trong Docker) dùng để gọi webhook về bridge.
BRIDGE_PUBLIC_URL=http://host.docker.internal:3200


# Chatwoot
CHATWOOT_BASE_URL=http://localhost:3100
# URL Chatwoot trình duyệt dùng, nếu khác CHATWOOT_BASE_URL (VD production bridge gọi Chatwoot qua mạng Docker).
# CHATWOOT_PUBLIC_URL=https://chat.example.com
CHATWOOT_ACCOUNT_ID=1
# Access token của user Chatwoot dành riêng cho bridge (Profile settings → Access token).
# User này cần quyền Administrator để tạo inbox và đọc webhook secret.
CHATWOOT_API_TOKEN=

# Database riêng của service (database `zalo_personal` trong postgres của infra/chatwoot)
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5433/zalo_personal

# 32 byte hex để mã hóa credentials Zalo: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

LOG_LEVEL=info
