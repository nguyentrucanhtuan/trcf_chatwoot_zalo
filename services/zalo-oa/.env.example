# HTTP server của service
HOST=127.0.0.1
PORT=3201
# URL mà Chatwoot (trong Docker) dùng để gọi webhook về service.
BRIDGE_PUBLIC_URL=http://host.docker.internal:3201

# Chatwoot (giống services/zalo-personal)
CHATWOOT_BASE_URL=http://localhost:3100
# CHATWOOT_PUBLIC_URL=https://chat.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=

# Database riêng của service
DATABASE_URL=postgres://postgres:<POSTGRES_PASSWORD>@localhost:5433/zalo_oa

# 32 byte hex: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

LOG_LEVEL=info

# --- Zalo OA ---
# App trên developers.zalo.me đã liên kết với OA.
ZALO_APP_ID=
ZALO_APP_SECRET=
# "OA Secret Key" trong mục Webhook của app (xác minh chữ ký webhook).
ZALO_OA_SECRET_KEY=
# URL HTTPS công khai của service này (Zalo gọi webhook và redirect OAuth về đây). Dev: dùng tunnel.
BRIDGE_EXTERNAL_URL=
